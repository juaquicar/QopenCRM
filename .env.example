DJANGO_SECRET_KEY='cambia-esto'
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Base de datos. Dentro de Docker los contenedores usan db:5432; estos valores son para ejecutar Django fuera de Docker.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Puertos publicados en el anfitrión (solo en 127.0.0.1)
DB_HOST_PORT=5433
WEB_PORT=8000
POSTGRES_DB=qopencrm
POSTGRES_USER=qopencrm
POSTGRES_PASSWORD=cambia-esto
# Correo: en desarrollo los códigos de acceso salen por consola
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=QopenCRM <crm@example.com>
SITE_URL=http://localhost:8000
# Con SITE_URL en https se levanta un proxy Caddy con certificado automático en los puertos 80 y 443.
# PROXY=0 lo desactiva si ya hay otro proxy inverso delante.
PROXY=1

# Captura automática de correo y reuniones: buzón compartido que el equipo pone en copia (CC/CCO) o al que reenvía.
# El worker lo lee cada 5 minutos por IMAP, en modo solo lectura.
MAIL_CAPTURE_HOST=
MAIL_CAPTURE_PORT=993
MAIL_CAPTURE_USER=
MAIL_CAPTURE_PASSWORD=
MAIL_CAPTURE_FOLDERS=INBOX
# La primera lectura solo mira los últimos N días
MAIL_CAPTURE_SINCE_DAYS=30

# Presupuestos: prefijo de la numeración (P26 000001…). El logo se cambia dejando el tuyo en branding/logo.png
QUOTE_NUMBER_PREFIX=P

# Copias de seguridad
BACKUP_KEEP=14
# Copia remota por FTP (comando: ./qopencrm.sh backup-ftp). Protocolo: ftp, ftps o sftp
FTP_PROTOCOL=ftps
FTP_HOST=
FTP_PORT=
FTP_USER=
FTP_PASSWORD=
FTP_DIR=/qopencrm
# Copias que se conservan en el servidor remoto (0 = no borrar nunca)
FTP_KEEP=30
# Asistente de IA (opcional): rellena fichas desde texto pegado y busca en lenguaje natural.
# Proveedor: openai o anthropic. AI_MODEL vacío = modelo por defecto del proveedor.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=

# App Android (TWA). Huella SHA-256 del certificado de firma del APK (varias separadas por comas)
ANDROID_PACKAGE=org.qopencrm.app
ANDROID_SHA256=

